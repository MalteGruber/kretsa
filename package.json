{
  "name": "kretsa",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "server",
    "cli",
    "web"
  ],
  "scripts": {
    "kretsa": "bun cli/src/main.ts",
    "dev": "bun --watch cli/src/main.ts serve --dev",
    "build": "bun run --filter @kretsa/web build",
    "start": "bun cli/src/main.ts serve",
    "typecheck": "bun run --filter '*' typecheck",
    "build:kicanvas": "cd vendor/kicanvas && npm ci && node scripts/build.js && mkdir -p ../../web/public/vendor && cp build/kicanvas.js ../../web/public/vendor/kicanvas.js"
  },
  "bin": {
    "kretsa": "cli/src/main.ts"
  }
}
